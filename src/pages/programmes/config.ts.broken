/**
 * Central configuration for all programmes
 * Edit programme details here - they'll update across the site
 */

export interface ProgrammeConfig {
  id: string;
  name: string;
  icon: string;
  tagline: string;
  description: string;
  color: string;
  duration: string;
  groupSize: string;
  timeCommitment: string;
  investment: string;
  location: string;
  whoFor: string;
  pipeline: {
    impactLab: string;
    platform: string;
    showcase: string;
    monetize: string;
  };
  learning: {
    cultural?: string[];
    technical?: string[];
    performance?: string[];
    professional?: string[];
  };
}

