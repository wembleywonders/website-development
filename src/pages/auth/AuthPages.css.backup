/* ========================================
   AUTHENTICATION PAGES - LOGIN & SIGNUP
   Community-first design matching homepage
   ======================================== */

/* Base Page Styling */
.auth-page {
  min-height: 100vh;
  background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
  color: #f8fafc;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  padding: 6rem 1.5rem 4rem;
  position: relative;
  overflow-x: hidden;
}

/* Background Effects */
.auth-bg-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(ellipse at center top, rgba(6, 182, 212, 0.08) 0%, transparent 50%);
  pointer-events: none;
}

.auth-bg-gradient {
  position: absolute;
  top: 20%;
  right: -10%;
  width: 40%;
  height: 50%;
  background: radial-gradient(circle, rgba(102, 126, 234, 0.1) 0%, transparent 70%);
  filter: blur(80px);
  pointer-events: none;
  animation: float 20s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translate(0, 0); }
  50% { transform: translate(-20px, 20px); }
}

/* Main Container */
.auth-container {
  position: relative;
  z-index: 2;
  max-width: 1200px;
  margin: 0 auto;
}

/* Header Section */
.auth-header {
  text-align: center;
  margin-bottom: 3rem;
}

.auth-logo {
  max-width: 120px;
  height: auto;
  margin-bottom: 1.5rem;
  border-radius: 50%;
  border: 3px solid rgba(6, 182, 212, 0.3);
}

.auth-logo-fallback {
  display: none;
  font-size: 4rem;
  margin-bottom: 1.5rem;
  justify-content: center;
}

.auth-title {
  font-size: 2.5rem;
  font-weight: 800;
  margin-bottom: 1rem;
  background: linear-gradient(135deg, #0ea5e9 0%, #06b6d4 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  line-height: 1.2;
}

.auth-subtitle {
  font-size: 1.1rem;
  color: #cbd5e1;
  max-width: 600px;
  margin: 0 auto;
  line-height: 1.6;
}

/* Form Wrapper */
.auth-form-wrapper {
  max-width: 500px;
  margin: 0 auto;
}

/* Alert Messages */
.auth-alerts {
  margin-bottom: 2rem;
}

.alert {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 1rem;
  border-radius: 0.75rem;
  margin-bottom: 1rem;
  font-size: 0.9rem;
  animation: slideDown 0.3s ease;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.alert-success {
  background: rgba(34, 197, 94, 0.1);
  border: 1px solid rgba(34, 197, 94, 0.2);
  color: #10b981;
}

.alert-error {
  background: rgba(239, 68, 68, 0.1);
  border: 1px solid rgba(239, 68, 68, 0.2);
  color: #ef4444;
}

.alert-icon {
  font-size: 1.2rem;
  flex-shrink: 0;
}

/* Form Card */
.auth-form-card {
  background: rgba(15, 23, 42, 0.6);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(51, 65, 85, 0.3);
  border-radius: 1.5rem;
  padding: 2rem;
  margin-bottom: 2rem;
}

/* Form Styling */
.auth-form {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}

.form-group {
  display: flex;
  flex-direction: column;
}

.form-label {
  display: block;
  font-size: 0.9rem;
  font-weight: 600;
  color: #cbd5e1;
  margin-bottom: 0.5rem;
}

.form-input {
  width: 100%;
  padding: 0.875rem;
  font-size: 1rem;
  border-radius: 0.5rem;
  border: 1px solid rgba(51, 65, 85, 0.4);
  background: rgba(51, 65, 85, 0.3);
  color: #f8fafc;
  outline: none;
  transition: all 0.2s ease;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #06b6d4;
  background: rgba(51, 65, 85, 0.4);
  box-shadow: 0 0 0 3px rgba(6, 182, 212, 0.1);
}

.form-input:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.form-input.error {
  border-color: #ef4444;
}

.form-input.error:focus {
  border-color: #ef4444;
  box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.1);
}

.form-input::placeholder {
  color: #64748b;
}

/* Date input styling */
.form-input[type="date"] {
  color-scheme: dark;
}

/* Password Wrapper */
.password-wrapper {
  position: relative;
}

.password-wrapper .form-input {
  padding-right: 3rem;
}

.password-toggle {
  position: absolute;
  right: 0.875rem;
  top: 50%;
  transform: translateY(-50%);
  background: none;
  border: none;
  color: #94a3b8;
  cursor: pointer;
  padding: 0;
  font-size: 1.1rem;
  transition: color 0.2s;
}

.password-toggle:hover {
  color: #cbd5e1;
}

/* Form Error & Hint */
.form-error {
  color: #ef4444;
  font-size: 0.8rem;
  margin-top: 0.375rem;
  margin-bottom: 0;
}

.form-hint {
  color: #94a3b8;
  font-size: 0.8rem;
  margin-top: 0.375rem;
  margin-bottom: 0;
}

/* Checkbox Styling */
.checkbox-label {
  display: flex;
  align-items: center;
  cursor: pointer;
  font-size: 0.9rem;
  color: #cbd5e1;
}

.checkbox-label.full {
  align-items: flex-start;
}

.checkbox-label.error {
  color: #ef4444;
}

.checkbox-input {
  margin-right: 0.5rem;
  accent-color: #06b6d4;
  cursor: pointer;
  width: 18px;
  height: 18px;
  flex-shrink: 0;
}

.inline-link {
  color: #06b6d4;
  text-decoration: underline;
  transition: color 0.2s;
}

.inline-link:hover {
  color: #0ea5e9;
}

/* Form Options */
.form-options {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.9rem;
}

.forgot-password-link {
  color: #06b6d4;
  text-decoration: underline;
  transition: color 0.2s;
}

.forgot-password-link:hover {
  color: #0ea5e9;
}

/* Submit Button */
.submit-button {
  width: 100%;
  padding: 1rem;
  font-size: 1rem;
  font-weight: 600;
  border-radius: 0.5rem;
  border: none;
  background: linear-gradient(135deg, #06b6d4 0%, #0ea5e9 100%);
  color: white;
  cursor: pointer;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
}

.submit-button:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(6, 182, 212, 0.4);
}

.submit-button:active:not(:disabled) {
  transform: translateY(0);
}

.submit-button:disabled {
  background: rgba(6, 182, 212, 0.5);
  cursor: not-allowed;
  transform: none;
}

.button-spinner {
  width: 16px;
  height: 16px;
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-top-color: white;
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* Alternate Link Section */
.auth-alternate {
  text-align: center;
  padding: 1.5rem;
  background: rgba(6, 182, 212, 0.05);
  border: 1px solid rgba(6, 182, 212, 0.1);
  border-radius: 1rem;
  margin-bottom: 2rem;
}

.auth-alternate p {
  margin: 0;
  font-size: 0.95rem;
  color: #cbd5e1;
}

.alternate-link {
  color: #06b6d4;
  text-decoration: none;
  font-weight: 600;
  transition: color 0.2s;
}

.alternate-link:hover {
  color: #0ea5e9;
  text-decoration: underline;
}

/* Community Benefits */
.auth-benefits {
  background: rgba(6, 182, 212, 0.05);
  border: 1px solid rgba(6, 182, 212, 0.1);
  border-radius: 1rem;
  padding: 1.5rem;
  text-align: center;
}

.benefits-title {
  font-size: 1.1rem;
  font-weight: 600;
  color: #06b6d4;
  margin: 0 0 1.25rem 0;
}

.benefits-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
  gap: 1.25rem;
}

.benefit-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
}

.benefit-icon {
  font-size: 1.75rem;
}

.benefit-text {
  font-size: 0.85rem;
  color: #94a3b8;
  font-weight: 500;
  text-align: center;
}

/* Responsive Design */
@media (max-width: 768px) {
  .auth-page {
    padding: 4rem 1rem 3rem;
  }

  .auth-title {
    font-size: 2rem;
  }

  .auth-subtitle {
    font-size: 1rem;
  }

  .auth-form-card {
    padding: 1.5rem;
  }

  .form-row {
    grid-template-columns: 1fr;
  }

  .benefits-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
}

@media (max-width: 480px) {
  .auth-page {
    padding: 3rem 1rem 2rem;
  }

  .auth-header {
    margin-bottom: 2rem;
  }

  .auth-logo {
    max-width: 80px;
  }

  .auth-title {
    font-size: 1.75rem;
  }

  .auth-subtitle {
    font-size: 0.95rem;
  }

  .auth-form-card {
    padding: 1.25rem;
  }

  .auth-form {
    gap: 1.25rem;
  }

  .form-input {
    font-size: 16px; /* Prevents zoom on iOS */
  }

  .form-options {
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .benefits-grid {
    grid-template-columns: 1fr;
  }
}

/* Dark Mode Support (if needed) */
@media (prefers-color-scheme: dark) {
  .auth-page {
    color-scheme: dark;
  }
}

/* Print Styles */
@media print {
  .auth-page {
    background: white;
    color: black;
  }

  .auth-bg-overlay,
  .auth-bg-gradient {
    display: none;
  }

  .submit-button {
    display: none;
  }
}