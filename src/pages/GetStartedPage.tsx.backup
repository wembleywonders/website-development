import React, { useState } from 'react';
import { ArrowRight, Clock, DollarSign, Users, CheckCircle, AlertCircle, Calendar, Target } from 'lucide-react';
import PageTemplate from '../components/PageTemplate';
import DraggableMaya from '../components/maya/DraggableMaya';
import './GetStartedPage.css';

const GetStartedPage: React.FC = () => {
  const [selectedPath, setSelectedPath] = useState<string | null>(null);
  const [currentStep, setCurrentStep] = useState<number>(1);

  type PathInfo = {
    id: string;
    title: string;
    subtitle: string;
    monthlyFee: number;
    timeCommitment: string;
    immediateAccess: string[];
    within30Days: string[];
    suitableFor: string[];
    notSuitableIf: string[];
    nextSteps: string[];
    realityCheck: string;
  };

  const pathways: PathInfo[] = [
    {
      id: 'skills-development',
      title: 'Skills Development Track',
      subtitle: 'Learn practical digital and creative skills',
      monthlyFee: 25,
      timeCommitment: '4-6 hours per week',
      immediateAccess: [
        'Access to current workshop schedule',
        'Community Discord server',
        'Digital resource library',
        'Mentorship matching system'
      ],
      within30Days: [
        'First workshop session attendance',
        'Skills assessment and learning plan',
        'Peer study group assignment',
        'Progress tracking setup'
      ],
      suitableFor: [
        'People aged 16-35 seeking employable skills',
        'Those with 4+ hours weekly availability',
        'Individuals comfortable with group learning',
        'People committed to 6+ month development journey'
      ],
      notSuitableIf: [
        'You expect immediate job placement',
        'You prefer entirely self-directed learning',
        'You cannot commit to regular attendance',
        'You are unwilling to participate in community activities'
      ],
      nextSteps: [
        'Complete skills interest questionnaire',
        'Attend orientation session (next: Jan 20th)',
        'Set up monthly payment method',
        'Join welcome group for new members'
      ],
      realityCheck: 'Skills development takes consistent effort over months, not weeks. Our members who succeed attend regularly and engage with peer learning.'
    },
    {
      id: 'community-connection',
      title: 'Community Connection Track',
      subtitle: 'Build relationships and contribute to local development',
      monthlyFee: 15,
      timeCommitment: '2-4 hours per week',
      immediateAccess: [
        'Community events calendar',
        'Volunteer opportunity matching',
        'Social media groups access',
        'Monthly community newsletter'
      ],
      within30Days: [
        'Welcome coffee with community coordinator',
        'First community event attendance',
        'Volunteer role selection and training',
        'Introduction to local partnerships'
      ],
      suitableFor: [
        'Adults seeking social connection in Wembley',
        'People interested in local community development',
        'Those with some volunteer time availability',
        'Individuals who enjoy collaborative activities'
      ],
      notSuitableIf: [
        'You only want to receive services without contributing',
        'You are unavailable for daytime or evening events',
        'You prefer anonymous participation',
        'You disagree with democratic decision-making processes'
      ],
      nextSteps: [
        'Complete community interest survey',
        'Schedule coffee meeting with coordinator',
        'Choose initial volunteer commitment',
        'Attend next community gathering (every 2nd Saturday)'
      ],
      realityCheck: 'Community connection requires showing up consistently. The most satisfied members attend events regularly and contribute through volunteering.'
    },
    {
      id: 'professional-development',
      title: 'Professional Development Track',
      subtitle: 'Access business consulting and networking',
      monthlyFee: 45,
      timeCommitment: '6-10 hours per week',
      immediateAccess: [
        'Business mentorship program',
        'Professional networking events',
        'Industry-specific workshops',
        'One-on-one consultation scheduling'
      ],
      within30Days: [
        'Business assessment consultation',
        'Professional development plan creation',
        'Industry mentor introduction',
        'First networking event attendance'
      ],
      suitableFor: [
        'Business owners or aspiring entrepreneurs',
        'Professionals seeking career advancement',
        'People with existing business experience',
        'Those able to invest significant time in development'
      ],
      notSuitableIf: [
        'You are just starting your career',
        'You cannot commit to regular professional activities',
        'You prefer low-cost learning options',
        'You expect immediate business results'
      ],
      nextSteps: [
        'Schedule business consultation call',
        'Complete professional background assessment',
        'Select primary development focus area',
        'Commit to 6-month development program'
      ],
      realityCheck: 'Professional development requires substantial time investment and active networking. Success depends on your existing experience and commitment level.'
    }
  ];

  const handlePathSelection = (pathId: string) => {
    setSelectedPath(pathId);
    setCurrentStep(2);
  };

  const getSelectedPath = (): PathInfo | null => {
    return selectedPath ? pathways.find(p => p.id === selectedPath) || null : null;
  };

  const PathwayCard = ({ pathway }: { pathway: PathInfo }) => (
    <div className="pathway-card">
      <div className="pathway-header">
        <h3>{pathway.title}</h3>
        <p className="pathway-subtitle">{pathway.subtitle}</p>
      </div>

      <div className="pathway-commitment">
        <div className="commitment-item">
          <DollarSign size={18} />
          <span>£{pathway.monthlyFee}/month</span>
        </div>
        <div className="commitment-item">
          <Clock size={18} />
          <span>{pathway.timeCommitment}</span>
        </div>
      </div>

      <div className="pathway-benefits">
        <h4>Immediate Access</h4>
        <ul className="benefits-list">
          {pathway.immediateAccess.map((benefit, index) => (
            <li key={index}>
              <CheckCircle size={14} />
              {benefit}
            </li>
          ))}
        </ul>

        <h4>Within 30 Days</h4>
        <ul className="benefits-list">
          {pathway.within30Days.map((benefit, index) => (
            <li key={index}>
              <Target size={14} />
              {benefit}
            </li>
          ))}
        </ul>
      </div>

      <div className="suitability-check">
        <div className="suitable-section">
          <h5>Suitable if you are:</h5>
          <ul>
            {pathway.suitableFor.map((criteria, index) => (
              <li key={index}>{criteria}</li>
            ))}
          </ul>
        </div>

        <div className="unsuitable-section">
          <h5>Not suitable if:</h5>
          <ul>
            {pathway.notSuitableIf.map((criteria, index) => (
              <li key={index}>{criteria}</li>
            ))}
          </ul>
        </div>
      </div>

      <div className="reality-check">
        <AlertCircle size={16} />
        <p>{pathway.realityCheck}</p>
      </div>

      <button 
        className="select-pathway-btn"
        onClick={() => handlePathSelection(pathway.id)}
      >
        Choose This Path
        <ArrowRight size={18} />
      </button>
    </div>
  );

  const ConfirmationStep = () => {
    const pathway = getSelectedPath();
    if (!pathway) return null;

    return (
      <div className="confirmation-step">
        <h2>Confirm Your Choice: {pathway.title}</h2>
        
        <div className="commitment-summary">
          <h3>Your Commitment</h3>
          <div className="commitment-details">
            <div className="detail-item">
              <strong>Monthly Investment:</strong> £{pathway.monthlyFee}
            </div>
            <div className="detail-item">
              <strong>Time Commitment:</strong> {pathway.timeCommitment}
            </div>
            <div className="detail-item">
              <strong>Minimum Commitment:</strong> 6 months (you can cancel anytime after)
            </div>
          </div>
        </div>

        <div className="next-steps-preview">
          <h3>Your Next Steps</h3>
          <ol className="next-steps-list">
            {pathway.nextSteps.map((step, index) => (
              <li key={index}>{step}</li>
            ))}
          </ol>
        </div>

        <div className="final-reality-check">
          <h3>Final Reality Check</h3>
          <p>
            Community membership works when people engage consistently. Our most successful members 
            attend regularly, participate in activities, and contribute to the community. If you are 
            ready for active participation rather than passive consumption, this is right for you.
          </p>
        </div>

        <div className="confirmation-buttons">
          <button 
            className="back-btn"
            onClick={() => setCurrentStep(1)}
          >
            Choose Different Path
          </button>
          <button 
            className="confirm-btn"
            onClick={() => setCurrentStep(3)}
          >
            Yes, I'm Ready to Commit
            <ArrowRight size={18} />
          </button>
        </div>
      </div>
    );
  };

  const NextStepsDetail = () => {
    const pathway = getSelectedPath();
    if (!pathway) return null;

    return (
      <div className="next-steps-detail">
        <h2>Welcome to Wembley Wonders!</h2>
        <p>Here's exactly what happens next:</p>

        <div className="immediate-actions">
          <h3>This Week</h3>
          <div className="action-timeline">
            <div className="timeline-item">
              <div className="timeline-marker">1</div>
              <div className="timeline-content">
                <h4>Set Up Payment</h4>
                <p>Complete secure payment setup for £{pathway.monthlyFee}/month</p>
                <button className="action-button primary">Set Up Payment Now</button>
              </div>
            </div>

            <div className="timeline-item">
              <div className="timeline-marker">2</div>
              <div className="timeline-content">
                <h4>Join Community Platforms</h4>
                <p>Access Discord, newsletter, and member resources</p>
                <button className="action-button secondary">Join Platforms</button>
              </div>
            </div>

            <div className="timeline-item">
              <div className="timeline-marker">3</div>
              <div className="timeline-content">
                <h4>Book Your Welcome Session</h4>
                <p>Schedule orientation with community coordinator</p>
                <button className="action-button secondary">Book Session</button>
              </div>
            </div>
          </div>
        </div>

        <div className="ongoing-expectations">
          <h3>What to Expect</h3>
          <div className="expectation-grid">
            <div className="expectation-item">
              <Calendar size={24} />
              <h4>Regular Communication</h4>
              <p>Weekly newsletter, event updates, and community news</p>
            </div>
            <div className="expectation-item">
              <Users size={24} />
              <h4>Community Engagement</h4>
              <p>Invitations to events, workshops, and collaborative projects</p>
            </div>
            <div className="expectation-item">
              <Target size={24} />
              <h4>Progress Tracking</h4>
              <p>Regular check-ins and development milestone recognition</p>
            </div>
          </div>
        </div>

        <div className="support-information">
          <h3>Questions or Concerns?</h3>
          <p>
            Community Coordinator: <strong>coordinator@wembleywonders.org</strong><br/>
            Response time: Within 24 hours<br/>
            Phone support: Available during orientation session booking
          </p>
        </div>

        <div className="cancellation-policy">
          <h3>Membership Terms</h3>
          <ul>
            <li>Monthly membership with 30-day notice for cancellation</li>
            <li>6-month minimum commitment for skill development programs</li>
            <li>Full refund within 14 days if not satisfied after orientation</li>
            <li>Community guidelines and participation expectations apply</li>
          </ul>
        </div>
      </div>
    );
  };

  return (
    <PageTemplate
      pageTitle="Get Started with Wembley Wonders"
      pageStrapline="Clear pathways to community membership with transparent costs, time commitments, and realistic expectations"
      pageType="community"
      bannerConfig={{
        raydyo: {
          title: "Community Radio",
          subtitle: "Our Voice",
          link: "/raydyo"
        },
        joystick: {
          title: "Digital Magazine", 
          subtitle: "Community Stories",
          link: "/joystick"
        }
      }}
    >
      {/* Enhanced Maya Integration */}
      <DraggableMaya 
        membershipTier="apply"
        pageType="community"
        pageContext={{
          title: "Get Started with Wembley Wonders",
          section: "membership",
          contentType: "application"
        }}
      />

      <div className="get-started-content">
        {currentStep === 1 && (
          <div className="pathways-section">
            <h2>Choose Your Community Path</h2>
            <p className="section-intro">
              Different people join our community for different reasons. Select the path below that matches 
              your goals, available time, and budget. Each path has clear requirements and realistic expectations.
            </p>

            <div className="pathways-grid">
              {pathways.map(pathway => (
                <PathwayCard key={pathway.id} pathway={pathway} />
              ))}
            </div>
          </div>
        )}

        {currentStep === 2 && <ConfirmationStep />}
        {currentStep === 3 && <NextStepsDetail />}
      </div>
    </PageTemplate>
  );
};

export default GetStartedPage;