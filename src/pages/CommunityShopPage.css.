/* src/pages/CommunityShopPage.css */
/* Content-specific styles only - PageTemplate handles layout */

/* Main Content Container */
.shop-content {
  max-width: 100%;
}

/* Shop Overview Stats */
.shop-overview {
  margin: 2rem 0 3rem 0;
  padding: 2rem;
  background: rgba(15, 23, 42, 0.6);
  border-radius: 16px;
  border: 1px solid rgba(148, 163, 184, 0.1);
}

.overview-stats {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 2rem;
}

.stat-card {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1.5rem;
  background: rgba(30, 41, 59, 0.5);
  border-radius: 12px;
  border: 1px solid rgba(148, 163, 184, 0.1);
  transition: all 0.3s ease;
}

.stat-card:hover {
  transform: translateY(-3px);
  border-color: rgba(6, 182, 212, 0.4);
  box-shadow: 0 10px 25px rgba(6, 182, 212, 0.15);
}

.stat-card svg {
  color: #06b6d4;
  flex-shrink: 0;
}

.stat-info {
  display: flex;
  flex-direction: column;
}

.stat-number {
  font-size: 2rem;
  font-weight: 900;
  color: #f8fafc;
  line-height: 1;
}

.stat-label {
  color: #cbd5e1;
  font-size: 0.9rem;
  font-weight: 500;
  margin-top: 0.25rem;
}

/* Advanced Filtering System */
.shop-filters {
  margin: 3rem 0;
  padding: 2rem;
  background: rgba(15, 23, 42, 0.4);
  border-radius: 12px;
  border: 1px solid rgba(148, 163, 184, 0.1);
}

.filter-row {
  display: flex;
  gap: 2rem;
  align-items: end;
  flex-wrap: wrap;
}

.filter-group {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  min-width: 150px;
}

.filter-group label {
  color: #cbd5e1;
  font-size: 0.9rem;
  font-weight: 600;
}

.filter-select {
  padding: 0.75rem;
  background: rgba(30, 41, 59, 0.8);
  border: 1px solid rgba(148, 163, 184, 0.3);
  border-radius: 8px;
  color: #f8fafc;
  font-size: 0.9rem;
  cursor: pointer;
  transition: all 0.3s ease;
}

.filter-select:focus {
  outline: none;
  border-color: #06b6d4;
  box-shadow: 0 0 0 2px rgba(6, 182, 212, 0.2);
}

.search-group {
  display: flex;
  align-items: center;
  position: relative;
  flex-grow: 1;
  max-width: 300px;
}

.search-group svg {
  position: absolute;
  left: 0.75rem;
  color: #94a3b8;
  z-index: 1;
}

.search-input {
  width: 100%;
  padding: 0.75rem 0.75rem 0.75rem 2.5rem;
  background: rgba(30, 41, 59, 0.8);
  border: 1px solid rgba(148, 163, 184, 0.3);
  border-radius: 8px;
  color: #f8fafc;
  font-size: 0.9rem;
  transition: all 0.3s ease;
}

.search-input::placeholder {
  color: #64748b;
}

.search-input:focus {
  outline: none;
  border-color: #06b6d4;
  box-shadow: 0 0 0 2px rgba(6, 182, 212, 0.2);
}

/* Product Grid with Lifecycle Management */
.products-section {
  margin: 4rem 0;
}

.products-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
  gap: 2rem;
}

.product-card {
  background: rgba(15, 23, 42, 0.8);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 1rem;
  padding: 1.5rem;
  transition: all 0.3s ease;
  display: flex;
  flex-direction: column;
  backdrop-filter: blur(20px);
  position: relative;
}

.product-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
}

.product-card.active {
  border-left: 4px solid #10b981;
}

.product-card.legacy {
  border-left: 4px solid #f59e0b;
}

.product-card.archived {
  border-left: 4px solid #64748b;
  opacity: 0.7;
}

.product-card.community-archive {
  border-left: 4px solid #8b5cf6;
}

.product-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1rem;
}

.product-category {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: #94a3b8;
  font-size: 0.8rem;
  font-weight: 500;
  text-transform: capitalize;
}

.product-status {
  padding: 0.25rem 0.75rem;
  border-radius: 15px;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.product-main {
  flex-grow: 1;
  margin-bottom: 1.5rem;
}

.product-main h3 {
  color: #f8fafc;
  font-size: 1.3rem;
  font-weight: 700;
  margin: 0 0 1rem 0;
  line-height: 1.3;
}

.product-description {
  color: #cbd5e1;
  line-height: 1.6;
  margin-bottom: 1rem;
  font-size: 0.95rem;
}

.creator-credit {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 1rem;
  padding: 0.75rem;
  background: rgba(139, 92, 246, 0.1);
  border-radius: 8px;
  border: 1px solid rgba(139, 92, 246, 0.2);
}

.creator-credit svg {
  color: #8b5cf6;
}

.creator-credit span {
  color: #cbd5e1;
  font-size: 0.85rem;
}

.level-badge {
  padding: 0.2rem 0.5rem;
  border-radius: 10px;
  font-size: 0.7rem;
  font-weight: 600;
  text-transform: uppercase;
  margin-left: 0.5rem;
}

.level-badge.beginner {
  background: rgba(16, 185, 129, 0.2);
  color: #10b981;
}

.level-badge.intermediate {
  background: rgba(245, 158, 11, 0.2);
  color: #f59e0b;
}

.level-badge.advanced {
  background: rgba(239, 68, 68, 0.2);
  color: #ef4444;
}

.workshop-connection {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 1rem;
  color: #06b6d4;
  font-size: 0.85rem;
}

.workshop-connection svg {
  color: #06b6d4;
}

.product-tags {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
  margin-bottom: 1rem;
}

.product-tag {
  display: flex;
  align-items: center;
  gap: 0.25rem;
  padding: 0.25rem 0.5rem;
  background: rgba(6, 182, 212, 0.1);
  color: #06b6d4;
  border-radius: 12px;
  font-size: 0.7rem;
  font-weight: 500;
  border: 1px solid rgba(6, 182, 212, 0.2);
}

.community-rating {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 1rem;
  color: #f59e0b;
  font-size: 0.9rem;
  font-weight: 600;
}

.rating-label {
  color: #94a3b8;
  font-size: 0.8rem;
  font-weight: 400;
}

.product-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: auto;
  padding-top: 1rem;
  border-top: 1px solid rgba(148, 163, 184, 0.1);
}

.price-section {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.price {
  font-size: 1.5rem;
  font-weight: 900;
  color: #10b981;
}

.stock {
  color: #94a3b8;
  font-size: 0.8rem;
}

.add-to-cart-btn {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.75rem 1.5rem;
  background: linear-gradient(135deg, #10b981, #059669);
  color: white;
  border: none;
  border-radius: 8px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
}

.add-to-cart-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(16, 185, 129, 0.3);
}

.legacy-actions {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  align-items: flex-end;
}

.legacy-btn {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 1rem;
  background: rgba(245, 158, 11, 0.1);
  color: #f59e0b;
  border: 1px solid rgba(245, 158, 11, 0.3);
  border-radius: 6px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.3s ease;
  font-size: 0.85rem;
}

.legacy-btn:hover {
  background: rgba(245, 158, 11, 0.2);
  transform: translateY(-1px);
}

.successor-link {
  color: #06b6d4;
  text-decoration: none;
  font-size: 0.8rem;
  font-weight: 500;
  transition: color 0.3s ease;
}

.successor-link:hover {
  color: #0891b2;
  text-decoration: underline;
}

.archived-btn {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 1rem;
  background: rgba(100, 116, 139, 0.1);
  color: #64748b;
  border: 1px solid rgba(100, 116, 139, 0.3);
  border-radius: 6px;
  font-weight: 500;
  cursor: not-allowed;
  font-size: 0.85rem;
}

.version-indicator {
  position: absolute;
  top: 1rem;
  right: 1rem;
  display: flex;
  align-items: center;
  gap: 0.25rem;
  padding: 0.25rem 0.5rem;
  background: rgba(6, 182, 212, 0.1);
  color: #06b6d4;
  border: 1px solid rgba(6, 182, 212, 0.2);
  border-radius: 12px;
  font-size: 0.7rem;
  font-weight: 500;
}

.version-count {
  color: #94a3b8;
}

/* Workshop Integration Section */
.workshop-integration {
  margin: 4rem 0;
  text-align: center;
}

.workshop-integration h2 {
  color: #06b6d4;
  font-size: 2rem;
  margin-bottom: 1rem;
}

.workshop-integration p {
  color: #cbd5e1;
  font-size: 1.1rem;
  margin-bottom: 3rem;
  max-width: 600px;
  margin-left: auto;
  margin-right: auto;
}

.workshop-packages {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 2rem;
}

.package-card {
  background: rgba(15, 23, 42, 0.6);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 1rem;
  padding: 2rem;
  text-align: center;
  transition: all 0.3s ease;
  border-left: 4px solid #06b6d4;
}

.package-card:hover {
  transform: translateY(-5px);
  border-color: rgba(6, 182, 212, 0.4);
  box-shadow: 0 15px 35px rgba(6, 182, 212, 0.15);
}

.package-card svg {
  color: #06b6d4;
  margin-bottom: 1rem;
}

.package-card h4 {
  color: #f8fafc;
  font-size: 1.3rem;
  font-weight: 700;
  margin: 0 0 1rem 0;
}

.package-card p {
  color: #cbd5e1;
  line-height: 1.6;
  margin-bottom: 1.5rem;
}

.package-contents {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  margin-bottom: 1.5rem;
}

.package-contents span {
  color: #94a3b8;
  font-size: 0.85rem;
  padding: 0.25rem 0.5rem;
  background: rgba(30, 41, 59, 0.5);
  border-radius: 6px;
  border: 1px solid rgba(148, 163, 184, 0.1);
}

.package-price {
  font-size: 1.8rem;
  font-weight: 900;
  color: #10b981;
}

/* Product Lifecycle Management */
.lifecycle-management {
  margin: 4rem 0;
  text-align: center;
}

.lifecycle-management h2 {
  color: #06b6d4;
  font-size: 2rem;
  margin-bottom: 3rem;
}

.lifecycle-info {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 2rem;
}

.lifecycle-stage {
  padding: 2rem;
  background: rgba(15, 23, 42, 0.6);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 1rem;
  transition: all 0.3s ease;
}

.lifecycle-stage:hover {
  transform: translateY(-3px);
  box-shadow: 0 10px 25px rgba(6, 182, 212, 0.15);
}

.stage-icon {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 1.5rem auto;
  transition: all 0.3s ease;
}

.stage-icon.active {
  background: rgba(16, 185, 129, 0.2);
  color: #10b981;
  border: 2px solid rgba(16, 185, 129, 0.3);
}

.stage-icon.legacy {
  background: rgba(245, 158, 11, 0.2);
  color: #f59e0b;
  border: 2px solid rgba(245, 158, 11, 0.3);
}

.stage-icon.archived {
  background: rgba(100, 116, 139, 0.2);
  color: #64748b;
  border: 2px solid rgba(100, 116, 139, 0.3);
}

.lifecycle-stage h4 {
  color: #f8fafc;
  font-size: 1.2rem;
  font-weight: 600;
  margin: 0 0 1rem 0;
}

.lifecycle-stage p {
  color: #cbd5e1;
  line-height: 1.6;
  margin: 0;
}

/* Responsive Design */
@media (max-width: 768px) {
  .shop-content {
    padding: 0;
  }
  
  .overview-stats {
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  
  .stat-card {
    padding: 1rem;
    flex-direction: column;
    text-align: center;
    gap: 0.5rem;
  }
  
  .filter-row {
    flex-direction: column;
    gap: 1rem;
    align-items: stretch;
  }
  
  .search-group {
    max-width: none;
  }
  
  .products-grid {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  
  .product-card {
    padding: 1.25rem;
  }
  
  .product-footer {
    flex-direction: column;
    gap: 1rem;
    align-items: stretch;
  }
  
  .add-to-cart-btn,
  .legacy-btn,
  .archived-btn {
    justify-content: center;
  }
  
  .workshop-packages {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  
  .lifecycle-info {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
}

@media (max-width: 480px) {
  .shop-overview,
  .shop-filters {
    padding: 1.5rem;
  }
  
  .overview-stats {
    grid-template-columns: 1fr;
  }
  
  .product-card {
    padding: 1rem;
  }
  
  .product-main h3 {
    font-size: 1.1rem;
  }
  
  .package-card {
    padding: 1.5rem;
  }
  
  .lifecycle-stage {
    padding: 1.5rem;
  }
  
  .stage-icon {
    width: 50px;
    height: 50px;
  }
}