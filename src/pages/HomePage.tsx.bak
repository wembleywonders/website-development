const WriteForEasyStreet: React.FC = () => (
  <section className="hp-write" id="hp-write">
    <div className="hp-section-inner">
      <div className="hp-write-inner">
        <div className="hp-write-scene">
          <div className="hp-scene-card">
            <div className="hp-scene-header">
              <span className="hp-scene-label">Easy Street · Scene 1.01</span>
              <span className="hp-scene-location">Jackson and Myrtle's kitchen. Early Sunday morning.</span>
            </div>
            <div className="hp-scene-body">
              <div className="hp-scene-direction">
                The gas ring hissing. Radio — old gospel. Jackson in his good shirt.
              </div>
              <div className="hp-scene-line">
                <span className="hp-scene-speaker">MYRTLE</span>
                <span className="hp-scene-speech">Where you going dressed like that?</span>
              </div>
              <div className="hp-scene-line">
                <span className="hp-scene-speaker">JACKSON</span>
                <span className="hp-scene-speech"><em>(on his way to the door)</em> Out.</span>
              </div>
              <div className="hp-scene-line">
                <span className="hp-scene-speaker">MYRTLE</span>
                <span className="hp-scene-speech">Out where?</span>
              </div>
              <div className="hp-scene-line">
                <span className="hp-scene-speaker">JACKSON</span>
                <span className="hp-scene-speech">Just out, Myrtle.</span>
              </div>
              <div className="hp-scene-direction">A beat.</div>
              <div className="hp-scene-line">
                <span className="hp-scene-speaker">MYRTLE</span>
                <span className="hp-scene-speech">You ironed that shirt.</span>
              </div>
              <div className="hp-scene-direction">A long beat. Thirty years in it.</div>
              <div className="hp-scene-line">
                <span className="hp-scene-speaker">JACKSON</span>
                <span className="hp-scene-speech">
                  <em>(on his way to the door)</em>{' '}
                  You know what your problem is? You h-ugly in the morning.
                </span>
              </div>
              <div className="hp-scene-direction">
                Sound: the front door. Not slammed. Closed. Which is worse.
              </div>
              <div className="hp-scene-ellipsis">· · ·</div>
            </div>
            <div className="hp-scene-footer">
              <span className="hp-scene-lineage">
                Written in the tradition of RAPP — Radical Alliance of Poets and Players,
                Brixton 1972. With acknowledgment to Jamal Ali, originator.
              </span>
            </div>
          </div>
        </div>

        <div className="hp-write-right">
          <h2 className="hp-write-heading">The writing room<br />is open.</h2>
          <p className="hp-write-sub">
            What happens next? Does Pearl answer?
            What does Auntie Budgie say when she finds out?
            Or bring your own characters into the world —
            your grandmother's kitchen, your uncle who always
            dressed too well for wherever he was going.
          </p>
          <p className="hp-write-promise">
            Write it. Bring it to the workshop. It will be produced,
            broadcast, and archived{' '}
            <strong>with your name on it.</strong>
          </p>
          <p className="hp-write-promise">That exists. Nobody can take it away.</p>
          <div className="hp-write-actions">
            <Link to="/programmes/easy-street/sandbox" className="hp-write-cta-primary">
              Write a scene →
            </Link>
            <Link to="/programmes/easy-street" className="hp-write-cta-secondary">
              Watch Easy Street first
            </Link>
          </div>
          <p className="hp-write-note">
            No account required to write.
            Account required to submit and be credited.
          </p>
        </div>
      </div>
    </div>
  </section>
);

