          <h2 className="hp-pool-ticker-heading">This is what's in the pool right now.</h2>
          <p className="hp-pool-ticker-sub">
            Every transaction. Every sale. 25p of every pound, accumulating in real time.
            Governed by members. Distributed by the community.
            Not a promise — a live number.
          </p>
          <p className="hp-pool-ticker-pardner">
            This is the pardner hand at digital scale.
          </p>
          <Link to="/how-it-works#community-pool" className="hp-pool-ticker-link">
            How the community pool is governed →
          </Link>
        </div>
        <div className="hp-pool-ticker-widget">
          <CommunityPoolTicker />
        </div>
      </div>
    </div>
  </section>
);

