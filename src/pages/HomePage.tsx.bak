              </Link>
              <Link to="/programmes/easy-street" className="hp-cta hp-cta--outline">
                Set the scene first
              </Link>
            </div>
            <div className="hp-footer-org">
              Wembley Wonders CIC · Company No. 12960817<br />
              Flat 2, 452 High Road, Wembley HA9 7AY · 0208 902 9991<br />
              <span>
                Written in the tradition of RAPP — Radical Alliance of Poets
                and Players, Brixton 1972. With acknowledgment to Jamal Ali, originator.
              </span><br />
              <span>All volunteers DBS-checked · Activity logs viewable by parents</span>
            </div>
          </div>
        </div>
      </section>
    </div>
  );
};

export default HomePage;