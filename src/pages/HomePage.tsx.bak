import React, { useState, useEffect, useRef, useCallback } from 'react';
import { Link } from 'react-router-dom';
import { CastingTable } from '../components/easy-street/CastingTable';
import { CommunityPoolTicker } from '../components/cyberstore/CommunityPoolTicker';
import './HomePage.css';

// ─────────────────────────────────────────────────────────────────────────────
// HomePage — Wembley Wonders CIC · April 2026
// Community Pool Ticker added after GoldStaysHere section.
// All inline Copland palette styles removed.
// Colours are now exclusively via HomePage.css and CSS variables.
// ─────────────────────────────────────────────────────────────────────────────

const openMaya = (source: string) =>
  window.dispatchEvent(new CustomEvent('maya:open', { detail: { source, mode: 'guided' } }));

const useInteractionState = () => {
  const [hasInteracted, setHasInteracted] = useState(false);
  const markInteracted = useCallback(() => setHasInteracted(true), []);
  return { hasInteracted, markInteracted };
};

// ─────────────────────────────────────────────────────────────────────────────
// BEAT 1: HERO
// ─────────────────────────────────────────────────────────────────────────────

interface HeroProps { onInteract: () => void; }

const EasyStreetHero: React.FC<HeroProps> = ({ onInteract }) => {
  const [hasInteracted, setHasInteracted] = useState(false);
  const [mode, setMode] = useState<'none' | 'watch' | 'shape'>('none');
  const [suggestion, setSuggestion] = useState('');
  const [submitted, setSubmitted] = useState(false);
  const [generating, setGenerating] = useState(false);
  const audioRef = useRef<HTMLAudioElement>(null);

  const handlePlay = () => {
    setHasInteracted(true);
    setMode('watch');
    onInteract();
    if (audioRef.current) {
      audioRef.current.play().catch(() => {});
    }
  };

  const handleShape = () => { setHasInteracted(true); setMode('shape'); onInteract(); };

  const handleSubmit = async () => {
    if (!suggestion.trim()) return;
    setGenerating(true);
    await new Promise(r => setTimeout(r, 1800));
    setGenerating(false);
    setSubmitted(true);
  };

  const scrollToCasting = () =>
    document.getElementById('hp-casting')?.scrollIntoView({ behavior: 'smooth' });

  return (
    <section className="hp-hero">
      <div className="hp-hero-grain" aria-hidden="true" />

      <div className="hp-hero-inner">

        {/* LEFT — Judith's words */}
        <div className="hp-hero-words">
          <p className="hp-hero-mum">Mum said, as I got on the train —</p>
          <blockquote className="hp-hero-quote">
            "You're coming to London<br />for a better life."
          </blockquote>
          <p className="hp-hero-landing">
            A half empty suitcase, a new job, a flat-share.{' '}
            <em>Humour intact.</em>
          </p>
          <p className="hp-hero-landing hp-hero-landing--street">
            That's how I landed on Easy Street.
          </p>
          <p className="hp-hero-found">
            And amid the tears, surprises,<br />
            disappointments and setbacks,<br />
            I found unexpected laughter,<br />
            fonder memories and unquenchable hope.
          </p>
          <cite className="hp-hero-attribution">
            — Judith Fontanelle, Co-founder · @BryceOfWembley
          </cite>
        </div>

        {/* RIGHT — passive/active fork */}
        <div className="hp-hero-player">
          <div className="hp-player-screen">

            <div className={`hp-player-static ${hasInteracted ? 'hp-player-static--fade' : ''}`}
              aria-hidden="true">
              <div className="hp-player-static-lines" />
            </div>

            <div className={`hp-player-info ${hasInteracted ? 'hp-player-info--visible' : ''}`}>
              <span className="hp-player-badge">📻 EASY STREET</span>
              <span className="hp-player-scene">Scene 1.01 — Sunday Morning</span>
            </div>

            {!hasInteracted && (
              <div className="hp-player-fork">
                <p className="hp-player-fork-label">Step into the street —</p>
                <div className="hp-player-fork-choices">
                  <button className="hp-fork-watch" onClick={handlePlay}>
                    <span className="hp-fork-icon">▶</span>
                    <div>
                      <div className="hp-fork-title">Watch</div>
                      <div className="hp-fork-sub">Scene 1.01 plays</div>
                    </div>
                  </button>
                  <button className="hp-fork-shape" onClick={handleShape}>
                    <span className="hp-fork-icon">✍</span>
                    <div>
                      <div className="hp-fork-title">Shape it</div>
                      <div className="hp-fork-sub">Tell us what happens next</div>
                    </div>
                  </button>
                </div>
              </div>
            )}

            {mode === 'watch' && (
              <div className="hp-player-playing">
                <div className="hp-player-waveform" aria-hidden="true">
                  {Array.from({ length: 20 }).map((_, i) => (
                    <span key={i} className="hp-player-bar"
                      style={{ animationDelay: `${i * 0.07}s` }} />
                  ))}
                </div>
                <p className="hp-player-now-playing">
                  <strong>Jackson & Myrtle's kitchen.</strong>{' '}
                  Early Sunday morning. The gas ring hissing.
                  Radio — old gospel. Jackson in his good shirt.
                </p>
                <button className="hp-player-casting-nudge" onClick={scrollToCasting}>
                  Or set your own scene below ↓
                </button>
              </div>
            )}

            {mode === 'shape' && !submitted && (
              <div className="hp-player-shape">
                <p className="hp-player-shape-prompt">
                  What do you want to happen on Easy Street this week?
                </p>
                <textarea
                  className="hp-player-shape-input"
                  placeholder="A wedding at St Wesley's. Bruk-up fixes the church bell. Don takes the community on a mystery coach trip..."
                  value={suggestion}
                  onChange={e => setSuggestion(e.target.value)}
                  rows={3}
                  maxLength={280}
                  aria-label="Your suggestion for Easy Street"
                />
                <div className="hp-player-shape-footer">
                  <span className="hp-player-shape-count">{suggestion.length}/280</span>
                  <button
                    className="hp-player-shape-submit"
                    onClick={handleSubmit}
                    disabled={!suggestion.trim() || generating}
                  >
                    {generating ? 'The street is listening...' : 'Submit →'}
                  </button>
                </div>
                <button className="hp-player-casting-nudge" onClick={scrollToCasting}>
                  Want more control? Use the Casting Table below ↓
                </button>
              </div>
            )}

            {mode === 'shape' && submitted && (
              <div className="hp-player-generated">
                <div className="hp-player-generated-badge">✓ Your suggestion is in the street</div>
                <p className="hp-player-generated-text">
                  Yaw and Afua are working with it — your personalised
                  scene is being written in the Easy Street voice.
                </p>
                <p className="hp-player-generated-poll">
                  Want it considered for the canonical episode?
                </p>
                <Link to="/auth/signup" className="hp-player-generated-cta">
                  Save it and enter the community poll →
                </Link>
                <p className="hp-player-generated-note">Free account · Takes 2 minutes</p>
              </div>
            )}

            <audio ref={audioRef} src="/audio/easy-street-scene-1-01.mp3" preload="none" />
          </div>

          <div className="hp-player-meta">
            <span className="hp-player-meta-pill">Written by the community</span>
            <span className="hp-player-meta-pill">Produced on Rayd-yo</span>
            <span className="hp-player-meta-pill">New scenes weekly</span>
          </div>

          {!hasInteracted && (
            <p className="hp-player-nudge">
              Or drag characters and set your own scene —{' '}
              <button className="hp-player-nudge-link" onClick={scrollToCasting}>
                The Casting Table ↓
              </button>
            </p>
          )}
        </div>
      </div>

      <div className="hp-hero-tagline">
        <span>Street made</span>
        <span className="hp-hero-tagline-dot" aria-hidden="true">·</span>
        <span>Creators owned</span>
        <span className="hp-hero-tagline-dot" aria-hidden="true">·</span>
        <span>The street listens</span>
      </div>
    </section>
  );
};

// ─────────────────────────────────────────────────────────────────────────────
// BEAT 2: THE CASTING TABLE
// ─────────────────────────────────────────────────────────────────────────────

const CastingSection: React.FC = () => (
  <section className="hp-casting" id="hp-casting">
    <div className="hp-section-inner">
      <CastingTable />
    </div>
  </section>
);

// ─────────────────────────────────────────────────────────────────────────────
// BEAT 3: COMMUNITY PULSE / POLL
// ─────────────────────────────────────────────────────────────────────────────

interface PulseData {
  count: number;
  pollOpens: string;
  topCombos: Array<{ characters: string[]; location: string; }>;
}

const CommunityPulse: React.FC = () => {
  const [pulse, setPulse] = useState<PulseData | null>(null);

  useEffect(() => {
    setPulse({ count: 0, pollOpens: 'Friday', topCombos: [] });
  }, []);

  return (
    <section className="hp-poll-section">
      <div className="hp-section-inner">

        {pulse && pulse.count > 0 && (
          <div className="hp-pulse">
            <div className="hp-pulse-inner">
              <div className="hp-pulse-dot" aria-hidden="true" />
              <p className="hp-pulse-text">
                <strong>{pulse.count.toLocaleString()}</strong> scenes set this week.
                {pulse.pollOpens && <> Poll opens <strong>{pulse.pollOpens}</strong>.</>}
              </p>
              <Link to="/auth/signup" className="hp-pulse-cta">Join to vote →</Link>
            </div>
          </div>
        )}

        <div className="hp-poll-explain">
          <div className="hp-poll-explain__header">
            <div className="hp-poll-explain__title-wrap">
              <span className="hp-poll-live-dot" aria-hidden="true" />
              <h2 className="hp-poll-explain__title">
                The community decides what happens next.
              </h2>
            </div>
            <p className="hp-poll-explain__sub">
              Write a scene. Submit it. Every Friday the strongest scenes go to a community poll.
              Members vote — and the winner becomes the <em>canonical next episode</em> of Easy Street.
              Produced. Broadcast. Archived. <strong>Your name on all four programmes.</strong>
            </p>
          </div>

          <div className="hp-poll-steps">
            {[
              {
                day: 'Mon – Thu',
                title: 'Editorial team reads every submission',
                sub: 'Every scene gets a specific response — not a form rejection.',
              },
              {
                day: 'Friday',
                title: 'Up to five scenes go to the community poll',
                sub: 'Any registered member can vote. 72 hours. One vote.',
              },
              {
                day: 'Monday',
                title: 'The winning scene goes into production',
                sub: 'Pageturners scripts it. Rayd-yo records it. G-Tech Casters animates. Trubble n Bass scores.',
              },
              {
                day: 'On air',
                title: 'Your name on the broadcast. 55% of revenue goes to you.',
                sub: '25% into the community pool — the pardner hand principle — funding the next creator.',
                highlight: true,
              },
            ].map((step, i) => (
              <div key={i} className={`hp-poll-step${step.highlight ? ' hp-poll-step--highlight' : ''}`}>
                <span className="hp-poll-step__day">{step.day}</span>
                <div className="hp-poll-step__body">
                  <strong>{step.title}</strong>
                  <span>{step.sub}</span>
                </div>
              </div>
            ))}
          </div>

          <div className="hp-poll-ctas">
            <Link to="/programmes/easy-street/sandbox" className="hp-poll-cta-write">
              Write a scene →
            </Link>
            <Link to="/auth/signup" className="hp-poll-cta-join">
              Join free to vote →
            </Link>
          </div>
        </div>

      </div>
    </section>
  );
};

// ─────────────────────────────────────────────────────────────────────────────
// BEAT 4: HOW IT'S MADE
// ─────────────────────────────────────────────────────────────────────────────

interface HowItsMadeProps { hasInteracted: boolean; }

const HowItsMade: React.FC<HowItsMadeProps> = ({ hasInteracted }) => {
  const programmes = [
    {
      icon: '✍️', verb: 'Written by', activeVerb: 'Your scene written by',
      name: 'Pageturners',
      desc: 'The community writing room. Every scene attributed to its author. The full script developed from your staging.',
      href: '/programmes/pageturners', cta: 'Write for Easy Street',
      colour: '#0ea5e9',
    },
    {
      icon: '📻', verb: 'Produced on', activeVerb: 'Produced on',
      name: 'Rayd-yo',
      desc: 'Community radio. Your scene recorded and broadcast with your name in the credits.',
      href: '/raydyo', cta: 'Make the broadcast',
      colour: '#10b981',
    },
    {
      icon: '🎬', verb: 'Animated by', activeVerb: 'Animated by',
      name: 'G-Tech Casters',
      desc: 'The production house. Voice, motion, the world made visible. Your characters on screen.',
      href: '/programmes/gtechcasters', cta: 'Animate the world',
      colour: '#a855f7',
    },
    {
      icon: '🎵', verb: 'Scored by', activeVerb: 'Scored by',
      name: 'Trubble n Bass',
      desc: 'Original music from the street, owned by its makers. Every scene has its score.',
      href: '/programmes/trubble-n-bass', cta: 'Write the music',
      colour: '#6366f1',
    },
    {
      icon: '📰', verb: 'Documented by', activeVerb: 'Documented in',
      name: 'Joystick',
      desc: 'The community e-zine. Reviews, archive, the making made visible. Your name in the record.',
      href: '/joystick', cta: 'Document the making',
      colour: '#fbbf24',
    },
  ];

  return (
    <section className="hp-how-made" id="hp-how-made">
      <div className="hp-section-inner">
        <div className="hp-how-made-header">
          {hasInteracted ? (
            <>
              <h2 className="hp-section-title">Here's who would make it real.</h2>
              <p className="hp-section-sub">Five programmes. Every contributor named. Every scene archived.</p>
            </>
          ) : (
            <>
              <h2 className="hp-section-title">This is how it's made.</h2>
              <p className="hp-section-sub">Five programmes. One street. Every contributor named.</p>
            </>
          )}
        </div>

        <div className="hp-programmes-rail">
          {programmes.map((p) => (
            <div
              key={p.name}
              className={`hp-programme-card${hasInteracted ? ' hp-programme-card--active' : ''}`}
              style={{ '--card-accent': p.colour } as React.CSSProperties}
            >
              <div className="hp-programme-card-icon">{p.icon}</div>
              <div className="hp-programme-card-verb">
                {hasInteracted ? p.activeVerb : p.verb}
              </div>
              <div className="hp-programme-card-name">{p.name}</div>
              <p className="hp-programme-card-desc">{p.desc}</p>
              <Link to={`${p.href}/sandbox`} className="hp-programme-card-cta">
                {p.cta} →
              </Link>
            </div>
          ))}
        </div>

        <div className="hp-how-made-footer">
          <p className="hp-how-made-note">
            {hasInteracted
              ? <>Your scene goes through all five. <em>Your name on all five.</em></>
              : <>No account required to try. Account required to publish.{' '}
                  <em>The writing itself is the conversion moment.</em></>
            }
          </p>
        </div>
      </div>
    </section>
  );
};

