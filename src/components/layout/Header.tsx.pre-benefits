                  border: '1px solid rgba(234, 88, 12, 0.4)',
                  borderTop: '1px solid rgba(255, 255, 255, 0.1)',
                  cursor: 'pointer',
                  color: 'white',
                  fontWeight: '600',
                  boxShadow: '0 4px 8px rgba(234, 88, 12, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.2)',
                  textShadow: '0 1px 2px rgba(0, 0, 0, 0.3)'
