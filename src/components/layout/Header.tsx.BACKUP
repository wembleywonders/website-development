              </button>
              
              {activeDropdown === 'programmes' && (
                <div className="dropdown-menu">
                  <div className="dropdown-header">
                    <h4>Our Programmes</h4>
                    <p>Creative platforms & development</p>
                  </div>
                  
                  <Link to="/programmes" className="dropdown-item dropdown-item-featured" onClick={closeMenu}>
                    🎓 All Programmes
                  </Link>

                  <Link to="/creators-journal" className="dropdown-item" onClick={closeMenu}>
                    📔 Creator's Journal
                  </Link>

                  <div className="dropdown-divider"></div>
                  
                  <Link to="/programmes/stemgeneers" className="dropdown-item" onClick={closeMenu}>
                    🔬 STEMgeneers
                  </Link>
                  
                  <Link to="/programmes/techreneurs" className="dropdown-item" onClick={closeMenu}>
                    💼 TECHreneurs
                  </Link>
                  
                  <Link to="/programmes/kaywanas-court" className="dropdown-item" onClick={closeMenu}>
                    🎭 Kaywana's Court
                  </Link>
                  
                  <Link to="/programmes/pageturners" className="dropdown-item" onClick={closeMenu}>
                    ✍️ Pageturners Writer's Workshop
                  </Link>

                  <Link to="/programmes/gtechcasters" className="dropdown-item" onClick={closeMenu}>
                    🎙️ G-Tech Casters
                  </Link>

                  <div className="dropdown-divider"></div>
                  
                  <Link to="/raydyo" className="dropdown-item" onClick={closeMenu}>
                    📻 Raydyo Radio
                  </Link>
                  
                  <Link to="/joystick" className="dropdown-item" onClick={closeMenu}>
                    🎮 Joystick Magazine
                  </Link>
