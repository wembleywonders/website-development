            {/* Get Started Mobile */}
            <li className="mobile-nav-item">
              <Link to="/get-started" className="mobile-nav-link mobile-nav-featured" onClick={closeMenu}>
                🚀 Get Started {confidence > 0.6 ? '✨' : ''}
