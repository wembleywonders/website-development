                  <Link to="/calendar" className="dropdown-item" onClick={closeMenu}>
                    📅 Community Calendar
                  </Link>
                  
                  <Link to="/programmes" className="dropdown-item" onClick={closeMenu}>
                    🎓 All Programmes
                  </Link>
                  
                  <Link to="/workshops" className="dropdown-item" onClick={closeMenu}>
                    🔨 Workshops
                  </Link>

                  <div className="dropdown-divider"></div>
                  
                  <Link to="/programmes/stemgeneers" className="dropdown-item" onClick={closeMenu}>
                    🔬 STEMgeneers
                  </Link>
                  
                  <Link to="/programmes/techreneurs" className="dropdown-item" onClick={closeMenu}>
                    💼 TECHreneurs
                  </Link>
                  
                  <Link to="/programmes/gtechcasters" className="dropdown-item" onClick={closeMenu}>
                    🎙️ G-Tech Casters
                  </Link>
                  
                  <Link to="/programmes/kaywanas-court" className="dropdown-item" onClick={closeMenu}>
                    🎭 Kaywana's Court
                  </Link>
                  
                  <Link to="/programmes/pageturners" className="dropdown-item" onClick={closeMenu}>
                    ✍️ Pageturners Writer's Workshop
                  </Link>
