            </li>

            {/* Who We Are Mobile */}
            <li className="mobile-nav-item">
              <button 
                className="mobile-nav-toggle"
                onClick={() => handleDropdown('mobile-who-we-are')}
              >
                Who We Are {activeDropdown === 'mobile-who-we-are' ? '▲' : '▼'}
              </button>

              {activeDropdown === 'mobile-who-we-are' && (
                <div className="mobile-submenu">
                  <Link to="/about" className="mobile-nav-link" onClick={closeMenu}>
                    🏛️ About Us
                  </Link>

                  <Link to="/team" className="mobile-nav-link" onClick={closeMenu}>
                    ⚽ Team
                  </Link>

                  <Link to="/who-we-are/how-we-share-power" className="mobile-nav-link" onClick={closeMenu}>
                    ⚖️ How We Share Power
                  </Link>

                  <Link to="/who-we-are/directors-pathway" className="mobile-nav-link" onClick={closeMenu}>
                    👔 Directors Pathway
                  </Link>
                </div>
