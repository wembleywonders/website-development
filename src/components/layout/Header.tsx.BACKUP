//src/components/layout/Header.tsx
 
import React, { useState } from 'react';
import { Link, useLocation, useNavigate } from 'react-router-dom';
import { useSmartRouting } from '../../hooks/useSmartRouting';
import { SmartSearch } from '../smart/SmartSearch';
import './Header.css';

const Header: React.FC = () => {
  const [isMenuOpen, setIsMenuOpen] = useState(false);
  const [activeDropdown, setActiveDropdown] = useState<string | null>(null);
  const location = useLocation();
  const navigate = useNavigate();
  const { confidence, suggestedPath, welcomeMessage } = useSmartRouting();

  const toggleMenu = () => {
    setIsMenuOpen(!isMenuOpen);
  };

  const handleDropdown = (dropdown: string) => {
    setActiveDropdown(activeDropdown === dropdown ? null : dropdown);
  };

  const closeMenu = () => {
    setIsMenuOpen(false);
    setActiveDropdown(null);
  };

  const isActive = (path: string) => {
    return location.pathname === path || location.pathname.startsWith(path);
  };

  // Smart navigation items for Get Started dropdown
  const quickAccessItems = [
    {
      title: "Someone mentioned us on the radio?",
      href: "/raydyo",
      description: "Visit Raydyo community radio",
      icon: "📻",
      isHighlighted: confidence > 0.7 && suggestedPath === '/raydyo'
    },
    {
      title: "Looking for training?",
      href: "/workshops",
      description: "Skills workshops & development",
      icon: "🎯",
      isHighlighted: confidence > 0.7 && suggestedPath === '/workshops'
    },
    {
      title: "Heard about our gaming?",
      href: "/joystick",
      description: "Joystick Magazine & events",
      icon: "🎮",
      isHighlighted: confidence > 0.7 && suggestedPath === '/joystick'
    },
    {
      title: "Want to get involved?",
      href: "/membership",
      description: "Join our community",
      icon: "🤝",
      isHighlighted: confidence > 0.7 && suggestedPath === '/membership'
    }
  ];

  return (
    <>
      {/* Top Header Section - Logo, Title, Location Badge, Communications */}
      <header className="main-header">
        <div className="header-container">
          {/* Left: Brand Section with Logo, Name, and Location Badge */}
          <div className="header-brand">
            <Link to="/" className="brand-link" onClick={closeMenu}>
