                  </Link>
                  
                  <Link to="/work-with-us" className="dropdown-item" onClick={closeMenu}>
                    💼 Work With Us
                  </Link>
                </div>
              )}
            </li>

            {/* Account Dropdown */}
            <li 
              className="nav-item nav-dropdown"
