                  <Link to="/who-we-are/how-we-share-power" className="dropdown-item" onClick={closeMenu}>
                    ⚖️ How We Share Power
                  </Link>

                  <Link to="/who-we-are/directors-pathway" className="dropdown-item" onClick={closeMenu}>
                    👔 Directors Pathway
                  </Link>
