            {/* Programmes Mobile */}
            <li className="mobile-nav-item">
              <button 
                className="mobile-nav-toggle"
                onClick={() => handleDropdown('mobile-programmes')}
              >
                Programmes {activeDropdown === 'mobile-programmes' ? '▲' : '▼'}
              </button>
              
              {activeDropdown === 'mobile-programmes' && (
                <div className="mobile-submenu">
                  <Link to="/programmes" className="mobile-nav-link mobile-nav-featured" onClick={closeMenu}>
                    🎓 All Programmes
                  </Link>
                  
                  <Link to="/creators-journal" className="mobile-nav-link" onClick={closeMenu}>
                    📔 Creator's Journal
                  </Link>
                  
                  <Link to="/programmes/stemgeneers" className="mobile-nav-link" onClick={closeMenu}>
                    🔬 STEMgeneers
                  </Link>
                  
                  <Link to="/programmes/techreneurs" className="mobile-nav-link" onClick={closeMenu}>
                    💼 TECHreneurs
                  </Link>
                  
                  <Link to="/programmes/kaywanas-court" className="mobile-nav-link" onClick={closeMenu}>
                    🎭 Kaywana's Court
                  </Link>
                  
                  <Link to="/programmes/pageturners" className="mobile-nav-link" onClick={closeMenu}>
                    ✍️ Pageturners Workshop
                  </Link>

                  <Link to="/programmes/gtechcasters" className="mobile-nav-link" onClick={closeMenu}>
                    🎙️ G-Tech Casters
                  </Link>

                  <Link to="/raydyo" className="mobile-nav-link" onClick={closeMenu}>
                    📻 Raydyo Radio
                  </Link>
                  
                  <Link to="/joystick" className="mobile-nav-link" onClick={closeMenu}>
                    🎮 Joystick Magazine
                  </Link>
                </div>
