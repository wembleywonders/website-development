              {activeDropdown === 'mobile-whats-on' && (
                <div className="mobile-submenu">
                  <Link to="/calendar" className="mobile-nav-link" onClick={closeMenu}>
                    📅 Community Calendar
                  </Link>
                  
                  <Link to="/programmes" className="mobile-nav-link" onClick={closeMenu}>
                    🎓 All Programmes
                  </Link>
                  
                  <Link to="/workshops" className="mobile-nav-link" onClick={closeMenu}>
                    🔨 Workshops
                  </Link>

                  <Link to="/programmes/stemgeneers" className="mobile-nav-link" onClick={closeMenu}>
                    🔬 STEMgeneers
                  </Link>
                  
                  <Link to="/programmes/techreneurs" className="mobile-nav-link" onClick={closeMenu}>
                    💼 TECHreneurs
                  </Link>

                  <Link to="/programmes/kaywanas-court" className="mobile-nav-link" onClick={closeMenu}>
                    🎭 Kaywana's Court
                  </Link>
                  
                  <Link to="/programmes/pageturners" className="mobile-nav-link" onClick={closeMenu}>
                    ✍️ Pageturners Workshop
                  </Link>
                  
                  <Link to="/programmes/gtechcasters" className="mobile-nav-link" onClick={closeMenu}>
                    🎙️ G-Tech Casters
                  </Link>   
