                    <span className="item-subtitle">Tech entrepreneurship</span>
                  </Link>
                  
                  <Link to="/programmes/gtechcasters" className="dropdown-item" onClick={closeMenu}>
                    <strong>G-TechCasters</strong>
                    <span className="item-subtitle">Digital media & broadcasting</span>
                  </Link>
                  
                  <Link to="/programmes/trubble-n-bass" className="dropdown-item" onClick={closeMenu}>
                    <strong>Trubble n Bass</strong>
                    <span className="item-subtitle">Music production & cultural rhythms</span>
                  </Link>
                  
                  <Link to="/programmes/kaywanas-court" className="dropdown-item" onClick={closeMenu}>
                    <strong>Kaywana's Court</strong>
                    <span className="item-subtitle">Cultural heritage & identity</span>
                  </Link>

                  <Link to="/programmes/pageturners" className="dropdown-item" onClick={closeMenu}>
