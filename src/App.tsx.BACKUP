// Media platform pages
import RaydyoPage from './pages/RaydyoPage'
import JoystickPage from './pages/JoystickPage'

// Creator's Journal
import CreatorsJournalPage from './pages/creators-journal/CreatorsJournalPage'

// Members Bonus sub-pages
import IndividualBenefits from './pages/IndividualBenefits'
import CommunityOwnership from './pages/membership/CommunityOwnership'

// Who We Are sub-pages
import HowWeSharePower from './pages/who-we-are/HowWeSharePower'
import DirectorsPathway from './pages/who-we-are/DirectorsPathway'

// Team page
import TeamPage from './pages/team/TeamPage'

// Auth pages
import LoginPage from './pages/auth/LoginPage'
import SignupPage from './pages/auth/SignupPage'

// Membership pages
import MembershipPage from './pages/MembershipPage'
import ConnectorApplicationGatewayPage from './pages/ConnectorApplicationGatewayPage'
import ConnectorApplicationForm from './pages/ConnectorApplicationForm'
import ApplicationSuccessPage from './pages/ApplicationSuccessPage'
import AssessmentGuidePage from './pages/AssessmentGuidePage'
import ApplicationDashboard from './pages/ApplicationDashboard'
import CuratorPage from './pages/CuratorPage'
import ChampionPage from './pages/ChampionPage'
import CommunityOverviewPage from './pages/CommunityOverviewPage'
import ConnectorHandbookPage from './pages/ConnectorHandbookPage'
import SampleScenariosPage from './pages/SampleScenariosPage'
import SuccessStoriesPage from './pages/SuccessStoriesPage'
import PracticeAssessmentPage from './pages/PracticeAssessmentPage'
import ScheduleAssessmentPage from './pages/ScheduleAssessmentPage'

// Components
import Header from './components/layout/Header'
import Footer from './components/layout/Footer'

// Smart Routing Components
const SmartRedirectHandler: React.FC = () => {
  const location = useLocation();
  const navigate = useNavigate();

  useEffect(() => {
    const redirect = SmartRouting.handleSmartRedirects(location.pathname);
    if (redirect && redirect !== location.pathname) {
      navigate(redirect, { replace: true });
    }
  }, [location.pathname, navigate]);

  return null;
};

const RouteTracker: React.FC = () => {
  const location = useLocation();

  useEffect(() => {
    SmartRouting.trackInterest('page_visit', location.pathname);
  }, [location.pathname]);

  return null;
};

const SmartParameterRedirect: React.FC = () => {
  const navigate = useNavigate();
  const location = useLocation();

  useEffect(() => {
    const urlParams = new URLSearchParams(location.search);
    const interest = urlParams.get('to') || urlParams.get('interest') || urlParams.get('ref');
    
    if (interest) {
      const routing = SmartRouting.analyzeIncomingTraffic();
      if (routing.suggestedPath) {
        navigate(routing.suggestedPath, { 
          state: { 
            welcomeMessage: routing.welcomeMessage,
            trackingId: routing.trackingId 
          },
          replace: true 
        });
        return;
      }
    }
    
    navigate('/get-started', { replace: true });
  }, [navigate, location.search]);

  return (
    <div className="redirect-loading">
      <p>Taking you to the right place...</p>
    </div>
  );
};

const SmartNotFound: React.FC = () => {
  const location = useLocation();
  const navigate = useNavigate();
  const [suggestions, setSuggestions] = React.useState<string[]>([]);

  useEffect(() => {
    const path = location.pathname.toLowerCase();
    const suggestions: string[] = [];

    if (path.includes('radio') || path.includes('raydio') || path.includes('podcast')) {
      suggestions.push('/raydyo');
    }
    if (path.includes('game') || path.includes('joystic') || path.includes('magazine')) {
      suggestions.push('/joystick');
    }
    if (path.includes('media') || path.includes('caster') || path.includes('broadcast')) {
      suggestions.push('/programmes/gtechcasters');
    }
    if (path.includes('train') || path.includes('workshop') || path.includes('skill')) {
      suggestions.push('/workshops');
    }
    if (path.includes('member') || path.includes('join') || path.includes('apply')) {
      suggestions.push('/membership');
    }
    if (path.includes('contact') || path.includes('help') || path.includes('support')) {
      suggestions.push('/contact');
    }
    if (path.includes('shop') || path.includes('store') || path.includes('crown')) {
      suggestions.push('/shop');
    }
    if (path.includes('event') || path.includes('calendar')) {
      suggestions.push('/calendar');
    }
    if (path.includes('program') || path.includes('programme')) {
      suggestions.push('/programmes');
    }
    if (path.includes('volunteer')) {
      suggestions.push('/volunteers');
    }
    if (path.includes('hub') || path.includes('space')) {
      suggestions.push('/community-hubs');
    }
    if (path.includes('stem') || path.includes('code') || path.includes('robot')) {
      suggestions.push('/programmes/stemgeneers');
    }
    if (path.includes('tech') || path.includes('entrepreneur') || path.includes('business') || path.includes('startup')) {
      suggestions.push('/programmes/techreneurs');
    }
    if (path.includes('journal') || path.includes('portfolio') || path.includes('progress')) {
      suggestions.push('/creators-journal');
    }

    if (suggestions.length === 0) {
      suggestions.push('/get-started');
    }

    setSuggestions(suggestions);
  }, [location.pathname]);

  return (
    <div className="smart-not-found">
      <div className="not-found-content">
        <h1>Hmm, we can't find that page</h1>
        <p>But we think you might be looking for one of these:</p>
        
        <div className="suggestions">
          {suggestions.map((suggestion, index) => (
            <button
              key={index}
              className="suggestion-btn"
              onClick={() => navigate(suggestion)}
            >
              {suggestion === '/raydyo' && '📻 Raydyo Radio'}
              {suggestion === '/joystick' && '🎮 Joystick Magazine'}
              {suggestion === '/workshops' && '📚 Workshops'}
              {suggestion === '/membership' && '🤝 Membership'}
              {suggestion === '/contact' && '💬 Contact Us'}
              {suggestion === '/shop' && '🛍️ Community Shop'}
              {suggestion === '/calendar' && '📅 Events Calendar'}
              {suggestion === '/programmes' && '🎪 All Programmes'}
              {suggestion === '/volunteers' && '🙌 Volunteer'}
              {suggestion === '/community-hubs' && '🏘️ Community Hubs'}
              {suggestion === '/programmes/stemgeneers' && '🔬 STEMgeneers'}
              {suggestion === '/programmes/techreneurs' && '💼 TECHreneurs'}
              {suggestion === '/programmes/gtechcasters' && '🎙️ G-Tech Casters'}
              {suggestion === '/creators-journal' && '📔 Creator\'s Journal'}
              {suggestion === '/get-started' && '🌟 Get Started'}
            </button>
          ))}
        </div>

        <div className="not-found-help">
          <p>Still can't find what you're looking for?</p>
          <button 
            className="help-btn"
            onClick={() => navigate('/get-started')}
          >
            Let us help you find it
          </button>
        </div>
      </div>
    </div>
  );
};

function App() {
  return (
    <SafeComponent>
      <AuthProvider>
        <Router>
          <div className="App">
            <SmartRedirectHandler />
            <RouteTracker />
            
            <Header />
            
            <main>
              <Routes>
                {/* Auth Routes */}
                <Route path="/login" element={<LoginPage />} />
                <Route path="/signup" element={<SignupPage />} />
                
                {/* Core Routes */}
                <Route path="/" element={<HomePage />} />
                <Route path="/about" element={<AboutUsPage />} />
                <Route path="/team" element={<TeamPage />} />
                <Route path="/contact" element={<ContactPage />} />
                <Route path="/get-started" element={<GetStartedPage />} />
                <Route path="/programmes" element={<ProgrammesPage />} />
                <Route path="/calendar" element={<CommunityCalendarPage />} />
                <Route path="/shop" element={<CommunityShopPage />} />
                <Route path="/community-hubs" element={<CommunityHubsPage />} />
                <Route path="/workshops" element={<WorkshopsPage />} />
                <Route path="/workshop-calendar" element={<WorkshopCalendarPage />} />
                <Route path="/volunteers" element={<VolunteersPage />} />
                
                {/* Creator's Journal Route */}
                <Route path="/creators-journal" element={<CreatorsJournalPage />} />
                
                {/* Programme Routes */}
                <Route path="/programmes/kaywanas-court" element={<KaywanasCourtPage />} />
                <Route path="/programmes/pageturners" element={<PageturnersPage />} />
                <Route path="/programmes/stemgeneers" element={<STEMgeneersPage />} />
                <Route path="/programmes/techreneurs" element={<TECHreneursPage />} />
                <Route path="/programmes/gtechcasters" element={<GTechCastersPage />} />
                
                {/* Media Platform Routes */}
                <Route path="/raydyo" element={<RaydyoPage />} />
                <Route path="/joystick" element={<JoystickPage />} />
                
                {/* Community Investment Routes */}
                <Route path="/partner-with-us" element={<CommunityInvestmentPage />} />
                <Route path="/work-with-us" element={<WorkWithUsPage />} />
                <Route path="/business/signup" element={<BusinessSignup />} />
                
                {/* Membership Routes */}
                <Route path="/membership" element={<MembershipPage />} />
                <Route path="/connector-application" element={<ConnectorApplicationGatewayPage />} />
                <Route path="/apply" element={<ConnectorApplicationForm />} />
                <Route path="/application-success" element={<ApplicationSuccessPage />} />
                <Route path="/application-dashboard" element={<ApplicationDashboard />} />
                <Route path="/assessment-guide" element={<AssessmentGuidePage />} />
                <Route path="/practice-assessment" element={<PracticeAssessmentPage />} />
                <Route path="/schedule-assessment" element={<ScheduleAssessmentPage />} />
                <Route path="/curator" element={<CuratorPage />} />
                <Route path="/champion" element={<ChampionPage />} />
                <Route path="/community-overview" element={<CommunityOverviewPage />} />
                <Route path="/connector-handbook" element={<ConnectorHandbookPage />} />
                <Route path="/sample-scenarios" element={<SampleScenariosPage />} />
                <Route path="/success-stories" element={<SuccessStoriesPage />} />
                
                {/* Members Bonus Routes */}
                <Route path="/members-bonus" element={<IndividualBenefits />} />
                <Route path="/members-bonus/individual-benefits" element={<IndividualBenefits />} />
                <Route path="/members-bonus/community-ownership" element={<CommunityOwnership />} />
                
                {/* Who We Are sub-pages */}
                <Route path="/who-we-are/how-we-share-power" element={<HowWeSharePower />} />
                <Route path="/who-we-are/directors-pathway" element={<DirectorsPathway />} />
                
                {/* Backwards compatibility redirects */}
                <Route path="/community-investment" element={<Navigate to="/partner-with-us" replace />} />
                <Route path="/membership/benefits" element={<Navigate to="/members-bonus/individual-benefits" replace />} />
                <Route path="/members-benefits" element={<Navigate to="/members-bonus/individual-benefits" replace />} />
                
                {/* Enhanced smart redirects */}
                <Route path="/programs" element={<Navigate to="/programmes" replace />} />
                <Route path="/events" element={<Navigate to="/calendar" replace />} />
                <Route path="/store" element={<Navigate to="/shop" replace />} />
                
                {/* Programme alternative spellings/SEO redirects */}
                <Route path="/programs/stemgeneers" element={<Navigate to="/programmes/stemgeneers" replace />} />
                <Route path="/programs/techreneurs" element={<Navigate to="/programmes/techreneurs" replace />} />
                <Route path="/programs/gtechcasters" element={<Navigate to="/programmes/gtechcasters" replace />} />
                <Route path="/stem" element={<Navigate to="/programmes/stemgeneers" replace />} />
                <Route path="/entrepreneurship" element={<Navigate to="/programmes/techreneurs" replace />} />
                <Route path="/coding" element={<Navigate to="/programmes/stemgeneers" replace />} />
                <Route path="/robotics" element={<Navigate to="/programmes/stemgeneers" replace />} />
                <Route path="/startup" element={<Navigate to="/programmes/techreneurs" replace />} />
                <Route path="/media" element={<Navigate to="/programmes/gtechcasters" replace />} />
                <Route path="/podcast" element={<Navigate to="/raydyo" replace />} />
                <Route path="/podcasting" element={<Navigate to="/programmes/gtechcasters" replace />} />
                
                {/* Media platform redirects for SEO */}
                <Route path="/radio" element={<Navigate to="/raydyo" replace />} />
                <Route path="/magazine" element={<Navigate to="/joystick" replace />} />
                <Route path="/ezine" element={<Navigate to="/joystick" replace />} />
                
                {/* Tilted Crowns redirect */}
                <Route path="/tilted-crowns" element={<Navigate to="/shop" replace />} />
                <Route path="/crowns" element={<Navigate to="/shop" replace />} />
                
                {/* Creator's Journal redirects */}
                <Route path="/journal" element={<Navigate to="/creators-journal" replace />} />
                <Route path="/portfolio" element={<Navigate to="/creators-journal" replace />} />
                <Route path="/progress" element={<Navigate to="/creators-journal" replace />} />
                
                {/* Additional smart redirects for word-of-mouth traffic */}
                <Route path="/gaming" element={<Navigate to="/joystick" replace />} />
                <Route path="/games" element={<Navigate to="/joystick" replace />} />
                <Route path="/training" element={<Navigate to="/workshops" replace />} />
                <Route path="/skills" element={<Navigate to="/workshops" replace />} />
                <Route path="/courses" element={<Navigate to="/workshops" replace />} />
                <Route path="/classes" element={<Navigate to="/workshops" replace />} />
                <Route path="/learn" element={<Navigate to="/workshops" replace />} />
                <Route path="/register" element={<Navigate to="/signup" replace />} />
                <Route path="/join" element={<Navigate to="/membership" replace />} />
                <Route path="/help" element={<Navigate to="/contact" replace />} />
                <Route path="/support" element={<Navigate to="/contact" replace />} />
                <Route path="/faq" element={<Navigate to="/contact" replace />} />
                <Route path="/volunteer" element={<Navigate to="/volunteers" replace />} />
                
                {/* Smart URL parameter handling */}
