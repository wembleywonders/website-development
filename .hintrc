{
  "extends": [
    "development"
  ],
  "hints": {
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "backdrop-filter",
          "user-select",
          "min-width: fit-content",
          "-webkit-mask",
          "text-size-adjust",
          "color: color-mix(in srgb, var(--prog-color) 80%, black)",
          "border: 1px solid color-mix(in srgb, var(--prog-color) 10%, transparent)",
          "border: 1.5px solid color-mix(in srgb, var(--prog-color) 15%, transparent)",
          "border: 1px solid color-mix(in srgb, var(--prog-color) 15%, transparent)",
          "border-bottom: 1px solid color-mix(in srgb, var(--prog-color) 10%, transparent)",
          "border-color: color-mix(in srgb, var(--prog-color) 20%, transparent)",
          "border: 1.5px solid color-mix(in srgb, var(--prog-color, #6366f1) 15%, transparent)",
          "scrollbar-width",
          "scrollbar-width: thin",
          "border: 1px solid color-mix(in srgb, var(--prog-color) 20%, transparent)",
          "border: 2px solid color-mix(in srgb, var(--prog-color) 20%, transparent)",
          "border: 1px solid color-mix(in srgb, var(--prog-color) 25%, transparent)",
          "scrollbar-color",
          "border: 1px solid color-mix(in srgb, var(--path-color) 15%, transparent)",
          "border: 1px solid color-mix(in srgb, var(--card-color) 15%, transparent)",
          "border-color: color-mix(in srgb, var(--card-color) 30%, transparent)",
          "border: 1px solid color-mix(in srgb, var(--combo-colour) 25%, transparent)",
          "border: 1.5px solid color-mix(in srgb, var(--combo-colour) 15%, transparent)",
          "border: 1.5px solid color-mix(in srgb, var(--pipe-colour) 35%, transparent)",
          "border: 1px solid color-mix(in srgb, var(--q-colour, var(--hp-gold)) 25%, transparent)",
          "border: 1px solid color-mix(in srgb, var(--event-colour, var(--hp-gold)) 25%, transparent)",
          "border: 1px solid color-mix(in srgb, var(--era-colour, var(--hp-gold)) 30%, transparent)",
          "border: 1px solid color-mix(in srgb, var(--marker-colour, var(--hp-gold)) 30%, transparent)",
          "border-color: color-mix(in srgb, var(--filter-colour, var(--hp-gold)) 40%, transparent)",
          "border: 1px solid color-mix(in srgb, var(--path-color) 30%, transparent)",
          "border: 1px solid color-mix(in srgb, var(--pardner-gold) 20%, transparent)",
          "border: 1px solid color-mix(in srgb, var(--pardner-green) 20%, transparent)",
          "border: 1px solid color-mix(in srgb, var(--pardner-green) 30%, transparent)",
          "border: 1px solid color-mix(in srgb, var(--pardner-amber) 30%, transparent)",
          "border: 1px solid color-mix(in srgb, var(--store-red) 30%, transparent)"
        ]
      }
    ],
    "axe/forms": [
      "default",
      {
        "label": "off",
        "select-name": "off"
      }
    ],
    "no-inline-styles": "off",
    "axe/name-role-value": [
      "default",
      {
        "button-name": "off"
      }
    ],
    "axe/aria": [
      "default",
      {
        "aria-valid-attr-value": "off"
      }
    ],
    "axe/keyboard": [
      "default",
      {
        "nested-interactive": "off"
      }
    ]
  }
}